meta {
  name: 05 create a manual collection
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/collections
  body: json
  auth: none
}

body:json {
  {
    "canonicalTitle": "Bruno test collection",
    "romIds": ["{{romId}}"]
  }
}

assert {
  res.status: eq 201
  res.body.memberCount: eq 1
}

script:post-response {
  bru.setVar("collectionId", res.body.id);
}
