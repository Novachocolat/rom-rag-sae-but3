    "cookie-parser": "~1.4.7",
    "cors": "~2.8.6",
    "dotenv": "~17.4.2",
    "express": "~5.2.1",
    "helmet": "~8.3.0",
    "ioredis": "~6.0.0",
    "pg": "~8.23.0",
    "pgvector": "^0.3.0",
    "zod": "~4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prisma": "^7.10.0",
