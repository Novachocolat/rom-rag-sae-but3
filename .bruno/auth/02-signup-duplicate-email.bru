meta {
  name: 02 signup rejects a duplicate email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "a completely different password"
  }
}

assert {
  res.status: eq 409
  res.body.error.code: eq EMAIL_ALREADY_EXISTS
}
