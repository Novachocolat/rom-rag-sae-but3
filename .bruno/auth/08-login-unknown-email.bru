meta {
  name: 08 login rejects an unknown email the same way
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("unknownEmail", `nobody+${Date.now()}@example.com`);
}

body:json {
  {
    "email": "{{unknownEmail}}",
    "password": "does not matter"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq INVALID_CREDENTIALS
  res.body.error.message: eq Invalid credentials
}

docs {
  Same status, code and message as 07 (wrong password): an unknown email
  must be indistinguishable from a wrong password, otherwise the endpoint
  can be used to enumerate registered accounts.
}
