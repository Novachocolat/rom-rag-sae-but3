meta {
  name: 03 export the library as CSV
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/roms/export?format=csv
  body: none
  auth: none
}

tests {
  test("answers a CSV attachment", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.contain("text/csv");
    expect(res.getHeader("content-disposition")).to.contain("library.csv");
  });
}
