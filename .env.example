#! DO NOT SET REAL SECRET KEYS IN THIS FILE
#! USE .env FILE FOR DEVELOPMENT
#! USE .env.prod FILE FOR PRODUCTION
#! PLEASE DECLARE ANY NEW ENVIRONMENT VARIABLE IN `/shared/src/schemas/env.ts`

# Node environment
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000

# PostgreSQL
# TODO: Avoid using default postgres user and use a dedicated `app` schema instead of `public`
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app?schema=public

# Redis
# TODO: Avoid using default Redis user
REDIS_URL=redis://localhost:6379

# Ollama
# Use http://host.docker.internal:11434 instead if you run Ollama locally
OLLAMA_BASE_URL=http://10.22.28.190:11434
OLLAMA_LLM_MODEL=gemma4:26b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIM=768
OLLAMA_TIMEOUT_MS=120000
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_RETRIES=2
OLLAMA_THINKING=true

# ROM library
ROM_LIBRARY_ROOT=/roms
ROM_EXTENSIONS=.gb,.gbc,.gba,.nes,.sfc,.smc,.md,.bin,.gen
SCAN_CONCURRENCY=4

# Sessions
SESSION_COOKIE_NAME=rr_session
SESSION_TTL_SECONDS=604800

# AI
AI_CACHE_TTL_SECONDS=86400
AI_CONFIDENCE_THRESHOLD=0.75

# Ports (also read directly by docker-compose.yml)
POSTGRES_PORT=5433
FRONTEND_PORT=5173
DOCS_USER_PORT=4321
